{
	"name": "@inlang/compat-tests",
	"private": true,
	"type": "module",
	"description": "Tests that the current @inlang/sdk and plugins read and write the same project and translation files as the published versions.",
	"scripts": {
		"test": "tsc --noEmit && vitest run",
		"format": "prettier ./src --write"
	},
	"devDependencies": {
		"@inlang/plugin-android": "workspace:*",
		"@inlang/plugin-apple-strings": "workspace:*",
		"@inlang/plugin-apple-xcstrings": "workspace:*",
		"@inlang/plugin-i18next": "workspace:*",
		"@inlang/plugin-icu1": "workspace:*",
		"@inlang/plugin-json": "workspace:*",
		"@inlang/plugin-m-function-matcher": "workspace:*",
		"@inlang/plugin-message-format": "workspace:*",
		"@inlang/plugin-next-intl": "workspace:*",
		"@inlang/sdk": "workspace:*",
		"@inlang/tsconfig": "workspace:*",
		"@types/node": "^22.5.1",
		"published-plugin-android": "npm:@inlang/plugin-android@0.2.7",
		"published-plugin-apple-strings": "npm:@inlang/plugin-apple-strings@0.2.7",
		"published-plugin-apple-xcstrings": "npm:@inlang/plugin-apple-xcstrings@0.2.7",
		"published-plugin-i18next": "npm:@inlang/plugin-i18next@6.3.0",
		"published-plugin-icu1": "npm:@inlang/plugin-icu1@1.1.1",
		"published-plugin-json": "npm:@inlang/plugin-json@5.1.58",
		"published-plugin-m-function-matcher": "npm:@inlang/plugin-m-function-matcher@2.2.17",
		"published-plugin-message-format": "npm:@inlang/plugin-message-format@4.4.5",
		"published-plugin-next-intl": "npm:@inlang/plugin-next-intl@2.2.1",
		"published-sdk": "npm:@inlang/sdk@3.1.0",
		"prettier": "^3.5.1",
		"typescript": "^5.5.2",
		"vitest": "^3.2.4"
	}
}
