{
	"hello_world": "Hallo Welt!",
	"greeting": "Guten Morgen {name}!",
	"navigation": {
		"home": "Startseite"
	},
	"items": [
		{
			"declarations": ["input count", "local countPlural = count: plural"],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "Ein Artikel",
				"countPlural=other": "{count} Artikel"
			}
		}
	],
	"invite": [
		{
			"declarations": [
				"input gender",
				"input count",
				"local countPlural = count: plural"
			],
			"selectors": ["gender", "countPlural"],
			"match": {
				"gender=female, countPlural=one": "Sie hat einen Gast eingeladen",
				"gender=female, countPlural=*": "Sie hat {count} Gäste eingeladen",
				"gender=*, countPlural=*": "Eingeladen: {count} Gäste"
			}
		}
	]
}
