{
	"name": "@inlang/plugin-message-format",
	"version": "4.4.5",
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./file-schema": {
			"types": "./dist/fileSchema.d.ts",
			"default": "./dist/fileSchema.js"
		}
	},
	"files": [
		"./dist",
		"./assets"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/opral/inlang",
		"directory": "packages/plugins/inlang-message-format"
	},
	"scripts": {
		"dev": "node ./build.js",
		"build": "NODE_ENV=production node ./build.js",
		"test": "tsc --noEmit && vitest run --passWithNoTests",
		"test:watch": "vitest",
		"format": "prettier ./src --write",
		"clean": "rm -rf ./dist ./node_modules"
	},
	"devDependencies": {
		"@inlang/tsconfig": "workspace:*",
		"esbuild": "^0.24.2",
		"memfs": "4.6.0",
		"prettier": "^3.3.3",
		"typescript": "^5.5.2",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"flat": "^6.0.1",
		"@inlang/sdk": "workspace:*",
		"@sinclair/typebox": "^0.31.17"
	},
	"typesVersions": {
		"*": {
			"file-schema": [
				"dist/fileSchema.d.ts"
			]
		}
	}
}
