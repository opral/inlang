{
	"name": "@inlang/plugin-json",
	"version": "5.1.57",
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"./dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/opral/inlang",
		"directory": "packages/plugins/json"
	},
	"scripts": {
		"dev": "node ./build.js",
		"build": "NODE_ENV=production node ./build.js",
