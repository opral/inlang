		"@sinclair/typebox": "0.31.28",
		"@inlang/sdk": "workspace:*"
	},
	"devDependencies": {
		"@inlang/tsconfig": "workspace:*",
		"@types/flat": "^5.0.2",
		"@types/lodash.merge": "4.6.7",
		"esbuild": "^0.24.2",
		"flat": "^5.0.2",
		"lodash.merge": "4.6.2",
		"typescript": "^5.5.2",
		"vitest": "2.1.8"
	}
